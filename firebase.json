{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "rewrites": [
      { "source": "/login", "destination": "/login.html" },
      { "source": "/register", "destination": "/register.html" },
      { "source": "/signup", "destination": "/register.html" },
      { "source": "/logout", "destination": "/logout.html" },
      { "source": "/dashboard", "destination": "/dashboard.html" }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "package.json"
    ]
  }
}
